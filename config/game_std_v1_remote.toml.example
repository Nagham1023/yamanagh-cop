# Template for a real cross-team match over the P2P Cop-Thief Match
# Interoperability Specification (rule: play a group other than our own
# paired Thief). Copy this file to game_std_v1_remote.toml and fill in
# the REQUIRED placeholders before running `uv run python -m cop peer
# --private-config config/game_std_v1_remote.toml --tunnel`.
#
# Unlike a normal cop_v1/native match against our own paired Thief, the
# other team's own group id must be agreed and known *before* the match
# starts (it feeds directly into the signed game_uid derivation, rule 6)
# -- get it from the other team ahead of time, the same way you'd
# exchange tunnel URLs.

[game]
group_name = "dev-team"
group_id = "dev-team"
sub_game_number = 1
members = ["dev-1"]
repos = { cop = "https://github.com/Nagham1023/yamanagh-cop", thief = "https://github.com/yamandahle/thief-peer" }

[network]
my_port = 8801
# REQUIRED: the other team's real, reachable MCP URL (their own tunnel).
opponent_url = "https://REPLACE-WITH-THEIR-TUNNEL-URL/mcp"
turn_timeout_seconds = 180
opponent_protocol = "std_v1"
# REQUIRED: the other team's own group id, agreed on ahead of time.
opponent_group_id = "REPLACE-WITH-THEIR-GROUP-ID"

[trash_talk]
provider = "template"
every_n_steps = 1

[llm]
model = "claude-sonnet-5"
step_deadline_seconds = 30

[email]
recipient = "rmisegal+uoh26finalgame@gmail.com"
mode = "draft"
